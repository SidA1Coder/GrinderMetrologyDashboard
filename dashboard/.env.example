# Copy this file to `.env` and adjust. All values are optional — without them
# the dashboard runs in demo/mock mode.

# --- Model ---
# FS50_WEIGHTS=../runs/detect/corner/weights/best.pt
# FS50_CONF=0.25
# FS50_IMGSZ=640
# FS50_DEVICE=cpu

# --- Live source ---
# FS50_WATCH_DIR=./incoming
# FS50_ANNOTATED_DIR=./annotated

# --- SQL ODS product info ---
# Leave FS50_ODS_CONN blank to run in MOCK mode (product info from filename).
# Example (SQL Server via pyodbc):
# FS50_ODS_CONN=mssql+pyodbc://user:pass@host/DB?driver=ODBC+Driver+17+for+SQL+Server
# FS50_ODS_QUERY=SELECT location, part_id, corner FROM product_ods WHERE serial = :key
# FS50_USE_MOCK_DB=auto   # auto | true | false

# --- Locations (for heatmap + mock data) ---
# FS50_LOCATIONS=Line-A,Line-B,Line-C,Line-D

# --- Teams alerts ---
# Create an Incoming Webhook in the target Teams channel and paste the URL:
# FS50_TEAMS_WEBHOOK=https://outlook.office.com/webhook/xxxxx
